rules_version = '2';
// Arquivos do portal (Firebase Storage).
//
// - Ninguém LÊ pelo navegador: o morador abre o arquivo pelo portal
//   (/api/documentos/{id}/arquivo), que confere o login e o "Quem pode ver"
//   e entrega um link temporário de 5 minutos.
// - Só dá para CRIAR o arquivo de documento que o servidor autorizou:
//   o síndico recebe uma autorização de uso único (token com "envioDoc")
//   que vale para UM caminho exato. Nada de sobrescrever nem apagar daqui.
// - Fotos de anúncios e comunicados seguem o mesmo esquema ("envioFoto"),
//   e quem lê é a rota /api/fotos/..., que confere quem pode ver.
// - Tipo e tamanho são conferidos aqui e de novo no servidor ao salvar.
service firebase.storage {
  match /b/{bucket}/o {
    match /condominiums/{condominio}/documents/{envio}/{nome} {
      allow create: if request.auth != null
        && resource == null
        && 'envioDoc' in request.auth.token
        && request.auth.token.envioDoc == ('condominiums/' + condominio + '/documents/' + envio + '/' + nome)
        && request.resource.size > 0
        && request.resource.size <= 20 * 1024 * 1024
        && request.resource.contentType.matches(
          'application/pdf|image/(jpeg|png|webp)|application/msword|application/vnd[.]ms-excel|application/vnd[.]openxmlformats-officedocument[.](wordprocessingml[.]document|spreadsheetml[.]sheet)'
        );
    }

    // Fotos dos classificados (morador), dos comunicados e das áreas de lazer (síndico): mesma ideia,
    // com a autorização "envioFoto" para UM caminho exato. Só foto (JPEG, PNG ou
    // WebP) de até 5 MB — o navegador já reduz a foto antes de enviar.
    match /condominiums/{condominio}/{modulo}/{envio}/{nome} {
      allow create: if (modulo == 'classifieds' || modulo == 'announcements' || modulo == 'amenities')
        && request.auth != null
        && resource == null
        && 'envioFoto' in request.auth.token
        && request.auth.token.envioFoto == ('condominiums/' + condominio + '/' + modulo + '/' + envio + '/' + nome)
        && request.resource.size > 0
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
    }

    // Comprovantes dos lançamentos do caixa (síndico/tesouraria): mesma ideia, com a
    // autorização "envioComprovante" para UM caminho exato. PDF ou foto de até 20 MB.
    // Quem lê é a rota /api/financeiro/comprovantes/..., que confere quem pode ver o lançamento.
    match /condominiums/{condominio}/finance/{envio}/{nome} {
      allow create: if request.auth != null
        && resource == null
        && 'envioComprovante' in request.auth.token
        && request.auth.token.envioComprovante == ('condominiums/' + condominio + '/finance/' + envio + '/' + nome)
        && request.resource.size > 0
        && request.resource.size <= 20 * 1024 * 1024
        && request.resource.contentType.matches('application/pdf|image/(jpeg|png|webp)');
    }

    // Todo o resto: fechado.
    match /{caminho=**} {
      allow read, write: if false;
    }
  }
}
