# Copie este arquivo para .env.local e preencha. NUNCA envie o .env.local ao GitHub.
# No computador local, os valores abaixo já funcionam com o simulador (emuladores).

# ---------- Navegador (aparecem no site; não são segredos, mas ficam fora do código) ----------
NEXT_PUBLIC_FIREBASE_API_KEY=demo-chave-local
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-jardins.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-jardins
# Balde do Storage (arquivos dos documentos). Vazio = "<projeto>.firebasestorage.app".
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_APP_ID=
# true = usa o simulador local. Em produção: false.
NEXT_PUBLIC_USE_EMULATORS=true
NEXT_PUBLIC_AUTH_EMULATOR_URL=http://127.0.0.1:9099
# Chave do site reCAPTCHA (App Check). Vazio = App Check desligado no navegador.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=

# ---------- Servidor (SEGREDOS: só no .env.local e nas variáveis da Vercel) ----------
FIREBASE_PROJECT_ID=demo-jardins
# Conta de serviço (Firebase > Configurações > Contas de serviço). Vazio no local.
FIREBASE_CLIENT_EMAIL=
# Cole a chave entre aspas, com os \n como estão no arquivo JSON.
FIREBASE_PRIVATE_KEY=
# true = recusa pedidos sem token válido do App Check.
APP_CHECK_ENFORCE=false
# Segredo do HMAC dos códigos de visitante (portaria). Em produção: obrigatório, 32+ caracteres aleatórios
# (ex.: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"). Vazio no local = valor de desenvolvimento.
# ATENÇÃO: trocar o segredo invalida os códigos já gerados.
PORTARIA_SEGREDO_CODIGO=
# Condomínio do login do morador em /entrar sem ?c=. Vazio = jardins-do-lago.
# (Só monta o login; nada do portal abre sem login.) O nome antigo CONDOMINIO_PUBLICO ainda é aceito.
# No simulador, use jardins-do-lago-demo para o morador demo entrar sem o ?c=.
CONDOMINIO_PADRAO=

# ---------- Só no computador local ----------
# Quando estas duas existem, o Admin SDK fala com o simulador, e não com o Firebase real.
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199
